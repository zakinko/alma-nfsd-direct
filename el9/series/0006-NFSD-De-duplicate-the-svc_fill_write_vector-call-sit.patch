diff --git a/net/sunrpc/svc.c b/net/sunrpc/svc.c
index e04cb7c..4256974 100644
--- a/net/sunrpc/svc.c
+++ b/net/sunrpc/svc.c
@@ -1716,10 +1716,10 @@ EXPORT_SYMBOL_GPL(svc_encode_result_payload);
  * Fills in rqstp::rq_vec, and returns the number of elements.
