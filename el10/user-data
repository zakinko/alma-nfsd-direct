#cloud-config
disable_root: false
ssh_pwauth: false
ssh_authorized_keys:
  - @KEY@
runcmd:
  - dnf -y upgrade kernel kernel-core kernel-modules
  - dnf -y install epel-release kernel-modules-extra
  - dnf -y install nfs-utils mdadm xfsprogs nvme-cli util-linux rdma-core iproute
  - dnf -y install bpftrace || true
  - touch /var/tmp/ready
power_state:
  mode: reboot
  condition: test -f /var/tmp/ready
